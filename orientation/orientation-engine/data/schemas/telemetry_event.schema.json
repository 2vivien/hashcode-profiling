{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://othello.local/schemas/telemetry-event-v1.json",
  "title": "Otheloo Orientation Telemetry Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "student_id", "occurred_at"],
  "properties": {
    "event_id": {"type": "string", "minLength": 16},
    "event_type": {"type": "string", "enum": [
      "QUESTIONNAIRE_STARTED","QUESTIONNAIRE_COMPLETED","ADAPTIVE_QUESTION_SHOWN",
      "DIRECTION_CLICKED","JOB_DETAIL_DWELL_TIME","JOB_FAVORITED","JOB_COMPARED",
      "FORMATION_CLICKED","FORMATION_STARTED","FORMATION_COMPLETED",
      "USER_FEEDBACK_GIVEN","REAL_CHOICE_DECLARED"
    ]},
    "student_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "session_id": {"type": ["string","null"]},
    "direction_id": {"type": ["string","null"]},
    "position": {"type": ["integer","null"], "minimum": 1},
    "model_version": {"type": ["string","null"]},
    "questionnaire_version": {"type": ["string","null"]},
    "knowledge_version": {"type": ["string","null"]},
    "propensity": {"type": ["number","null"], "exclusiveMinimum": 0, "maximum": 1},
    "reward": {"type": ["number","null"], "minimum": -1, "maximum": 1},
    "context": {"type": "object"},
    "payload": {"type": "object"}
  }
}
