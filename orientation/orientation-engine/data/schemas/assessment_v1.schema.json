{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://othello.local/schemas/assessment-v1.json",
  "title": "Otheloo V1 Assessment Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "session_id", "student_id", "instrument_version", "answers"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "student_id": {"type": "string", "minLength": 1},
    "instrument_version": {"const": "othello-v1.0.0"},
    "answers": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "option_ids"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^(Q(0[1-9]|[1-3][0-9]|40)|adaptive_[a-z]+)$"},
        "option_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "answered_at": {"type": "string", "format": "date-time"}
      }
    }}
  }
}
