# Sandbox de développement — JupyterLab + outillage scientifique.
# Image VOLONTAIREMENT séparée de la production (Dockerfile) : elle n'affecte
# ni pyproject.toml ni uv.lock.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        git make curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml .python-version uv.lock ./
COPY requirements-dev.txt requirements-notebooks.txt requirements-v2-ml.txt ./
COPY src ./src
COPY data ./data
COPY notebooks ./notebooks

RUN uv sync --no-dev \
    && uv pip install -r requirements-dev.txt -r requirements-notebooks.txt -r requirements-v2-ml.txt

EXPOSE 8888
CMD ["uv", "run", "jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--ServerApp.token=", "--ServerApp.password="]
